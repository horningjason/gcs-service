<?xml version="1.0" encoding="UTF-8"?>
<!--
  RFC 4119 §2.2.5 — GEOPRIV Location Object (PIDF-LO extension to PIDF).

  Verbatim from RFC 4119 with two localisations:
    1. The basicPolicy import carries no schemaLocation in the RFC text.
       One is added here so the schema resolves offline.
    2. The xml.xsd import schemaLocation is changed to the local copy
       (the GCS XML parser runs with no_network=True).
  See schemas/README.md.

  Notes for the GCS implementation:
    - <location-info> content is xs:any namespace="##other" lax, so the
      civic (RFC 5139/6848/NENA) and geodetic (GML/GeoShape) payloads are
      only validated when their schemas are also loaded. That is what
      gcs-pidflo.xsd exists to guarantee.
    - <usage-rules> is minOccurs="1" — mandatory. GCS spec §8.3 passes
      retransmission-allowed through from the input unchanged.
    - <method> is declared here but GCS spec §8.3 / decision 12 never
      emits it: RFC 4119 §2.2.3 constrains its values to an IANA registry
      of device-positioning methods, none of which describes a position
      derived by matching a civic address to a GIS record.
-->
<xs:schema
  targetNamespace="urn:ietf:params:xml:ns:pidf:geopriv10"
  xmlns:tns="urn:ietf:params:xml:ns:pidf:geopriv10"
  xmlns:gbp="urn:ietf:params:xml:ns:pidf:geopriv10:basicPolicy"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  elementFormDefault="qualified" attributeFormDefault="unqualified">

  <xs:import namespace="urn:ietf:params:xml:ns:pidf:geopriv10:basicPolicy"
    schemaLocation="basicPolicy.xsd"/>

  <!-- This import brings in the XML language attribute xml:lang-->
  <xs:import namespace="http://www.w3.org/XML/1998/namespace"
    schemaLocation="xml.xsd"/>

  <xs:element name="geopriv" type="tns:geopriv"/>

  <xs:complexType name="geopriv">
   <xs:sequence>
     <xs:element name="location-info" type="tns:locInfoType"
        minOccurs="1" maxOccurs="1"/>
     <xs:element name="usage-rules" type="gbp:locPolicyType"
        minOccurs="1" maxOccurs="1"/>
     <xs:element name="method" type="tns:locMethod"
        minOccurs="0" maxOccurs="1"/>
     <xs:element name="provided-by" type="tns:locProvidedBy"
        minOccurs="0" maxOccurs="1"/>
     <xs:any namespace="##other" processContents="lax" minOccurs="0"
        maxOccurs="unbounded"/>
   </xs:sequence>
  </xs:complexType>

  <xs:complexType name="locInfoType">
   <xs:sequence>
     <xs:any namespace="##other" processContents="lax" minOccurs="0"
        maxOccurs="unbounded"/>
   </xs:sequence>
  </xs:complexType>

  <xs:complexType name="locMethod">
    <xs:simpleContent>
      <xs:extension base="xs:string">
        <xs:attribute ref="xml:lang" />
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="locProvidedBy">
   <xs:sequence>
     <xs:any namespace="##other" processContents="skip"
        minOccurs="1" maxOccurs="unbounded"/>
   </xs:sequence>
  </xs:complexType>

</xs:schema>
