# =============================================================================
# GCS Service — environment template
# =============================================================================
# Copy to .env and edit. Every variable this service reads appears here.
#
# Per spec §3.8 THIS FILE is the canonical variable reference — README.md and
# the spec point here rather than repeating a table that would drift. Section
# order matches §3.8's orientation-by-prefix.
#
# Two conventions used below:
#   [PROPOSAL]  — a starting value chosen by this implementation, NOT a spec
#                 value. Appendix C item (a) explicitly defers these to
#                 implementation. Expect to retune against real data.
#   [REQUIRED]  — startup fails if unset. No default is safe.
# =============================================================================


# -----------------------------------------------------------------------------
# Element Identity
# -----------------------------------------------------------------------------
# This element's globally-unique FQDN (i3 §2.1.3). Used as elementId and
# serviceId, and as the fallback for GCS_AGENCY_ID / GCS_SERVICE_DOMAIN.
GCS_SERVER_URI=gcs.example.com

# DNS-style identifier of the agency operating this GCS (i3 §2.1.1).
# Populates the agencyId field of every LogEvent prologue. Required for
# conformant i3 logging; a WARNING is logged at startup if unset.
# Example: nd911.nd.gov
# GCS_AGENCY_ID=

# ServiceState `domain` / `serviceId` (i3 §2.4.2). Defaults to GCS_SERVER_URI.
# GCS_SERVICE_DOMAIN=

# Log level for all GCS loggers (src.*). DEBUG | INFO | WARNING | ERROR.
# Does not affect uvicorn's own access log.
GCS_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Web Service Versions entry point (i3 §4.12 MUST, spec §A.1)
# -----------------------------------------------------------------------------
# The GCS is ONE web service with ONE /Versions entry point covering both
# operations (spec §3.9.1, Session 3, confirmed against the normative YAML).
# Bump minor for backwards-compatible changes, major for breaking ones.
GCS_VERSION_MAJOR=1
GCS_VERSION_MINOR=0

# Build/vendor identifier reported as "fingerprint" in the Versions response.
GCS_BUILD_FINGERPRINT=gcs-service-dev

# Advertise the i3-improved resources (/GeocodeEnhanced,
# /ReverseGeocodeEnhanced) through the Versions `vendor` parameter — i3's own
# sanctioned hook for a service declaring vendor-specific capability
# (spec §3.9.2, decision 35). Set to false to run strict-i3-only: the enhanced
# routes are then neither mounted nor advertised. The strict paths are
# byte-for-byte identical either way.
GCS_ENABLE_ENHANCED=true


# -----------------------------------------------------------------------------
# Process Management (per-machine multi-worker)
# -----------------------------------------------------------------------------
# Number of gunicorn worker processes on THIS machine. Read by gunicorn.conf.py.
# Default 1 == single-process behavior. Work is CPU-bound, so a reasonable
# starting point is ~the number of CPU cores, then measure.
# Only used under gunicorn; `python main.py` is always single-process.
# Multi-worker requires Linux or Docker (gunicorn is POSIX-only).
GCS_WORKERS=1

# Gunicorn worker timeout, seconds. Read by gunicorn.conf.py.
GCS_WORKER_TIMEOUT=120


# -----------------------------------------------------------------------------
# GIS Data (spec §3.3, §3.5)
# -----------------------------------------------------------------------------
# GeoPackage holding the two layers STA-006.3 Table 4-1 marks Required for the
# GCS. Both are provisioned by layer replication from the master SI (i3 §4.5).
# Unlike LVF there is no boundary-layer variable: the GCS is not provisioned
# with service boundary layers and has no coverage concept (§3.3, §3.6).
GCS_GPKG_PATH=data/data.gpkg

# Layer names within the GeoPackage. Defaults are the STA-006.3 standard names.
GCS_SSAP_LAYER=SiteStructureAddressPoint
GCS_RCL_LAYER=RoadCenterLine

# How often (seconds) to poll the GeoPackage mtime for hot-reload. 0 disables
# the watcher. /ready reports 503 while a reload is in flight (§3.9.4).
GCS_GPKG_POLL_INTERVAL_SECONDS=60


# -----------------------------------------------------------------------------
# Conversion tuning — GCS-specific (spec §6.3, §7.2, §7.3, §7.4, §10.2)
# -----------------------------------------------------------------------------
# All distances are METRES, as true geodesic distance on the WGS84 spheroid —
# never decimal degrees. Spec §10.2 settles this: a degree is not a distance,
# and a degrees-based radius would be a latitude-dependent ellipse that lets
# the CRS silently overrule the algorithm.

# [PROPOSAL] Perpendicular setback from an RCL centerline, applied on the side
# determined by matched address parity (§7.3, decision 30). MUST be > 0 — the
# returned position may never sit exactly on the centerline itself.
# Rationale for 10.0: roughly half a local-street right-of-way, so the point
# clears the pavement onto the near-side parcel without crossing the far one on
# a narrow rural road. Appendix C item (a) defers the value to implementation.
GCS_RCL_OFFSET_M=10.0

# [PROPOSAL] Distance trimmed off each end of an RCL segment's usable geometry
# before interpolation runs; the address range then compresses onto the
# shortened path (§7.2, decision 30). Exists because perpendicular offset
# direction is unstable near a joint or sharp bend close to a segment endpoint.
# Rationale for 15.0: clears a typical intersection curb radius while costing
# only ~15-30% of a 100-200 m block. Appendix C item (a) defers the value.
# Does NOT participate in the zero-length-range case (§7.2, decision 48) — a
# midpoint is nowhere near an endpoint.
GCS_RCL_ENDPOINT_MARGIN_M=15.0

# [PROPOSAL] Minimum matchScore (0-100) for a candidate to be admitted at all.
# This is an ENGINE-LEVEL ADMISSION GATE applied upstream of both interfaces,
# before either response assembly sees the candidate list — so rank 1 is
# identical on the i3 and i3-improved interfaces, which is what keeps the two
# a controlled comparison (§2.2, decision 9). Decision 9 governs DISCLOSURE,
# not admission: the i3 interface may not reveal that a match was fuzzy, but
# it is not obliged to serialise sub-threshold noise. A candidate below this
# floor is not a fuzzy match, it is a non-match.
# Rationale for 60.0: below roughly 60 a per-field similarity result is
# dominated by mismatched fields rather than spelling variance. Appendix C
# item (a) defers the value.
GCS_MIN_MATCH_SCORE=60.0

# [PROPOSAL] Maximum ReverseGeocode search distance (§10.2, decision 40).
# Mandatory as a concept: without a limit, a point in open water reverse-
# geocodes to whatever unfortunate address is nearest and returns 200. Where
# no candidate falls within it, the response is 468.
# Rationale for 250.0: tight enough that open water and open field return 468,
# loose enough that a rural coordinate off a section-line road still reaches
# the RCL. Urban deployments should tighten this considerably — treat it as a
# per-jurisdiction knob, not a constant. Appendix C item (a) defers the value.
# CAVEAT: §10.2 applies this value uniformly to BOTH the horizontal and the
# vertical component of the search. At 250 m the vertical band spans an
# 80-storey building, i.e. effectively no vertical constraint. Raised in
# spec Appendix C.4.
GCS_REVERSE_SEARCH_RADIUS_M=250.0

# Multiplier damping the ReverseGeocode spatial-fit score of a candidate whose
# STA-006.3 §6.1 Placement Method is "Geocoding" (§10.6, decision 66). Such a
# record's own position was derived by geocoding; reverse-geocoding it back to
# an address is a round trip through two approximations, and the score should
# say so. 1.0 disables the damping.
# Applies to the score only — it never reorders candidates, since §10.3's
# ordering is lexicographic and independent of the score.
# Rationale for 0.9 (decision 83): a settled editorial default, no longer a
# [PROPOSAL] strawman and no longer on Appendix C item (d)'s open list. It
# cannot change an answer — §10.3 orders on containment, tier, then distance,
# so this moves the reported spatial fit and confidence and nothing else — and
# it is not sweepable: STA-006.3's registry records THAT a placement was
# geocoded, never the error magnitude of that derivation, so there is no
# labeled outcome to score a sweep against. 0.9 says "roughly a tenth less
# spatial fit than a survey/structure/parcel placement," deliberately short of
# implying a known error. Because the honest value depends on the quality of
# YOUR SI's geocoding, THIS VARIABLE is the tuning mechanism: lower it if you
# know your geocoded placements are poor, raise it toward 1.0 if they are good.
GCS_GEOCODED_PLACEMENT_PENALTY=0.9

# [REQUIRED — no default] Horizontal agreement tolerance for the §6.3
# ambiguity test. Where surviving Geocode candidates differ horizontally by
# more than this, 468 is returned instead of a merged position; within it,
# they are averaged with uncertainty sized to their extent (decision 27).
#
# Deliberately has NO default and startup FAILS if unset. §6.3 names no value
# and Appendix C item (a) does not list this among the deferred defaults, so
# there is no spec figure to fall back on — and the choice is consequential in
# both directions. §6.3's own illustration is two matches "forty miles apart"
# (~64000 m), which is the far end; a city-block figure (~150 m) is the tight
# end and would turn a large class of legitimate averaging cases into 468.
# Picking silently would bury a real decision in a default. See
# spec Appendix C.4.
# GCS_AMBIGUITY_TOLERANCE_M=


# -----------------------------------------------------------------------------
# Referral (spec §3.6.2, decision 5, decision 34)
# -----------------------------------------------------------------------------
# URI of another GCS, emitted in the Location header of a 307 when conversion
# fails. Statically provisioned — the GCS performs no coverage test and makes
# no judgment about who is authoritative (§3.6, decision 4).
#
# LEAVING THIS UNSET IS A DELIBERATE, DOCUMENTED STATE, not an oversight:
# failures then return 468 with no referral, a knowing departure from i3
# §4.5's MUST that is recorded as a §16 gap row. The deficit is data, not
# vocabulary — a correctly-scoped GCS does not know another GCS's URI.
# Note the consequence of having no coverage concept: when set, the referral
# is emitted on EVERY conversion failure, including for addresses that exist
# nowhere.
# GCS_REFERRAL_URI=


# -----------------------------------------------------------------------------
# Time (spec §A.2, i3 §2.2)
# -----------------------------------------------------------------------------
# NTP server for the §2.2 drift budget (<= 0.1 s between elements). Loss of NTP
# synchronisation is an ElementState-reportable condition (§A.4).
GCS_NTP_SERVER=pool.ntp.org


# -----------------------------------------------------------------------------
# Logging (spec §A.3, i3 §4.12.3.1)
# -----------------------------------------------------------------------------
# i3 Logging Service base URI. LogEvents are POSTed to {uri}/LogEvents.
# Unset = stdlib logging only.
#
# The GCS obligation here is STRICTER than LVF's: i3 §4.5 states the service
# logs the invocation of the function "as well as the input and output
# objects" — the payloads, not merely the event. src/logging/'s
# GcsQueryLogEvent/GcsResponseLogEvent (decision 104) carry those payloads,
# emitted at every /Geocode and /ReverseGeocode return path regardless of
# this variable — unset just means stdlib logging only, no POST.
# GCS_LOGGING_SERVICE_URI=


# -----------------------------------------------------------------------------
# SIP state notification (spec §A.4, §A.5; i3 §2.4)
# -----------------------------------------------------------------------------
# i3 §4.5 places an identical MUST on the GCS as §4.4 does on the MCS: each FE
# MUST implement the server side of ElementState, and the set of GCS FEs within
# an ESInet MUST implement ServiceState.
#
# src/notify/sip_notifier.py's SipWireAdapter (ported from lvf-service) binds
# a real UDP+TCP listener and publishes ElementState/ServiceState over SIP,
# same as ElementState and ServiceState remain reachable over HTTP at
# /ElementState and /ServiceState regardless. Leader-gated under
# GCS_WORKERS > 1 (src/app/lifecycle.py's maybe_start_sip()) — only one
# worker binds the port.
GCS_ENABLE_SIP=true
GCS_SIP_HOST=0.0.0.0
GCS_SIP_PORT=5060
# Comma-separated subscriber URIs authorized to SUBSCRIBE (i3 §5.4). Unset or
# empty accepts all — same posture as lvf-service and mcs-service.
# GCS_SIP_ALLOWED_SUBSCRIBERS=


# -----------------------------------------------------------------------------
# Discrepancy Reporting (spec §A.6; i3 §3.7)
# -----------------------------------------------------------------------------
# i3 §3.7: every database, service, and agency MUST provide a DR web service.
# Core mounts the four §3.7.1-3.7.3 resources at /dr when enabled.
GCS_ENABLE_DR_SERVICE=true

# RFC 7095 jCard contact carried on DR responses (§3.7.1). Both are logged as
# warnings at startup if unset.
# GCS_DR_CONTACT_NAME=
# GCS_DR_CONTACT_EMAIL=

# This element's own DR service base, sent as resolutionUri when THIS service
# files a report against another entity (e.g. a GIS DR against the SI).
# GCS_DR_RESOLUTION_URI=

# HTTP endpoint to POST Discrepancy Reports to (the SI's .../Reports web
# service) — decision 99: structural provisioning defects only (GIS
# load/reload failure, null NGUID, no usable geometry, multi-part centerline
# segments), never attribution content. When unset, DRs are logged locally
# only — src/discrepancy/discrepancy_report.py's detection call sites still
# run and still flag records, they just have nowhere to submit to.
# GCS_DR_ENDPOINT=https://dr.example.com/Reports


# -----------------------------------------------------------------------------
# Transport security (spec §3.9.3, §A.8; i3 §2.8.1, NENA-STA-040.2-2024)
# -----------------------------------------------------------------------------
# disabled | tls | mtls. HTTPS is mandatory in a real ESInet deployment;
# `disabled` is for local development only.
# TLS 1.2 MUST, TLS 1.3 MAY, TLS 1.0/1.1 MUST NOT, PFS within the ESInet.
GCS_TLS_MODE=disabled

# Server credentials — required when GCS_TLS_MODE is tls or mtls.
# GCS_TLS_CERT_FILE=certs/gcs.crt
# GCS_TLS_KEY_FILE=certs/gcs.key

# CA bundle — required when GCS_TLS_MODE=mtls.
# GCS_TLS_CA_FILE=certs/ca.crt

# Break-glass ONLY. Under gunicorn+UvicornWorker with GCS_TLS_MODE=mtls, the
# listener enforces CERT_REQUIRED by default: a client presenting no
# certificate, or an untrusted one, is rejected at the handshake (i3 §5.4).
# Setting this to true forces CERT_OPTIONAL instead — the same downgrade
# LVF's history shows is dangerous (see reports/core_security_prior_art.md
# and src/app/gunicorn_worker.py's module docstring): a client presenting NO
# certificate is ACCEPTED, and i3 §5.4 mutual authentication is NOT enforced
# on that worker at all, silently, for every connection it handles. This
# exists only for the case where genuine CERT_REQUIRED enforcement is
# observed to actually fail in a specific deployment's environment, as a
# temporary aid to keep the service reachable while that failure is
# investigated. It MUST NOT be set in production. If you find yourself
# needing it, the correct next step is to report the environment that
# required it — toolchain versions, OS, worker count, what failed — not to
# leave this set. GcsUvicornWorker logs a WARNING naming this variable on
# every worker that starts with it enabled, so its use is never silent even
# if this comment goes unread.
# Default: unset (false) — CERT_REQUIRED enforced.
# GCS_GUNICORN_CERT_OPTIONAL_FALLBACK=false

# No separate outbound client-credential variables: in mtls mode, the GCS's
# own GCS_TLS_CERT_FILE/GCS_TLS_KEY_FILE double as the identity it presents
# on outbound calls (Logging Service, DR resolution callbacks/submissions),
# via i3_fe_core.security.tls.make_client_ssl_context — the same pattern
# i3-fe-core's own app/factory.py uses. GCS_TLS_CLIENT_CERT_FILE /
# GCS_TLS_CLIENT_KEY_FILE previously appeared here, inherited from the LVF
# template where the identically-named variables are genuine (LVF presents a
# distinct client certificate on its own peer-federation traffic, which the
# GCS has no equivalent of — spec §3.1, decision 4). They were removed rather
# than wired (decision 107): should the GCS ever need a second, separate
# outbound identity, that is its own requirement to specify, not a latent use
# for these two.


# -----------------------------------------------------------------------------
# Load shedding (spec §3.9.5, decision 100)
# -----------------------------------------------------------------------------
# Deliberately no variables here. Shedding is settled in shape (429 with
# Retry-After, a transport-layer response outside i3's closed conversion
# status set) but not yet implemented, and this file's contract is that it
# lists every variable the service actually reads — the load-shedding
# configuration arrives with the implementation that reads it.
